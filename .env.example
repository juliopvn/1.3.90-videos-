# =============================================================================
# VideoVault — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` (que NUNCA se commitea, ver .gitignore) y
# rellena los valores reales para tu entorno local.
#
#   cp .env.example .env.local
#
# Para generar un JWT_SECRET fuerte:
#   openssl rand -base64 32
#
# En producción (Fase 13 de PROMT.md) estas variables cambian de valor pero no
# de nombre ni de forma de uso en el código:
#   - MONGODB_URI          -> connection string de MongoDB Atlas
#   - RUSTFS_ENDPOINT      -> https://<ACCOUNT_ID>.r2.cloudflarestorage.com (Cloudflare R2)
#   - RUSTFS_ACCESS_KEY    -> Access Key ID del R2 API Token
#   - RUSTFS_SECRET_KEY    -> Secret Access Key del R2 API Token
#   - RUSTFS_BUCKET        -> nombre del bucket en R2
#   - RUSTFS_REGION        -> "auto" (valor que usa R2)
#   - JWT_SECRET           -> un secreto nuevo, distinto al de desarrollo
#   - NEXT_PUBLIC_APP_URL  -> https://videovault.jpavon-tech.com
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videovault

# --- RustFS (S3-compatible) ---
RUSTFS_ENDPOINT=http://localhost:9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=videos
RUSTFS_REGION=us-east-1

# --- Auth ---
# Genera uno nuevo con: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
